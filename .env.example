# ============================================================
#  KONFIGURASI DATABASE SUPABASE — Toko Sejahtera
# ============================================================
#
#  CARA MENGISI:
#  1. Buka https://supabase.com/dashboard → pilih project kamu
#  2. Klik ⚙️ Project Settings → API
#  3. Salin "Project URL"    → isi di VITE_SUPABASE_URL
#  4. Salin "anon public" key → isi di VITE_SUPABASE_ANON_KEY
#     (yang diawali "eyJ..." — JANGAN pakai service_role!)
#  5. Ubah VITE_LOCAL_MODE menjadi false di bawah
#  6. Restart server dev (Ctrl+C lalu npm run dev)
#
#  BELUM JALANKAN SKRIP DATABASE?
#  Buka file supabase-schema-secure.sql → salin seluruh isinya
#  → Supabase Dashboard → SQL Editor → Run.
# ============================================================

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 'true'  = data disimpan di browser (localStorage), tanpa cloud
# 'false' = data tersinkron ke Supabase (butuh kredensial di atas)
VITE_LOCAL_MODE=true
